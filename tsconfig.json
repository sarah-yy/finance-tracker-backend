{
	"compilerOptions": {
		"rootDir": "src",
		"outDir": "build",
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"moduleResolution": "node",
		"allowJs": false,
		"target": "ES2020",
		"lib": ["es2015"],
		"module": "ESNext",
		"noImplicitAny": true,
		"baseUrl": "./src",
		"paths": {
			"@fin-tracker/controllers/*": ["controllers/*"],
			"@fin-tracker/models/*": ["models/*"],
			"@fin-tracker/services/*": ["services/*"],
			"@fin-tracker/util/*": ["util/*"]
		}
	},
	"include": ["src/**/*"]
}