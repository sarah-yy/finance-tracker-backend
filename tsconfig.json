{
	"compilerOptions": {
		"rootDir": "src",
		"outDir": "build",
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"moduleResolution": "Bundler",
		"allowJs": false,
		"lib": ["es2015"],
		"module": "esnext",
		"noImplicitAny": true,
		"paths": {
			"@fin-tracker/controllers": ["./src/controllers/"],
			"@fin-tracker/models": ["./src/models/"],
			"@fin-tracker/services": ["./src/services/"],
			"@fin-tracker/util": ["./src/util/"],
		},
	}
}